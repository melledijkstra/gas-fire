{
  "name": "gas-fire",
  "version": "4.18.0-beta",
  "author": "Melle Dijkstra",
  "description": "Google App Script utilities to automate the FIRE google sheet",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "prepare": "husky",
    "serve": "vite",
    "dev": "pnpm build:dev && pnpm push && pnpm serve",
    "build": "vite build --config vite.gas.config.ts --mode production",
    "build:dev": "NODE_ENV=development vite build --config vite.gas.config.ts --mode production",
    "release": "pnpm build && pnpm push",
    "release:dev": "pnpm build:dev && pnpm push",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "push": "clasp push -f",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "local:ci": "pnpm build && pnpm lint && CI=true pnpm test",
    "local:ci:full": "CI=true pnpm install && pnpm build && pnpm lint && CI=true pnpm test && pnpm storybook:build && pnpm docs:build",
    "setup:https": "mkdir certs && mkcert -key-file ./certs/key.pem -cert-file ./certs/cert.pem localhost 127.0.0.1",
    "switch-env": "tsx ./scripts/switch-env.ts",
    "faker": "tsx ./scripts/faker/faker.ts",
    "knip": "knip"
  },
  "dependencies": {
    "papaparse": "^5.7.0",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@google/clasp": "^3.4.1",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/svelte": "^10.5.10",
    "@storybook/svelte-vite": "^10.5.10",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/google-apps-script": "^2.0.12",
    "@types/node": "^25.9.5",
    "@types/papaparse": "^5.5.2",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "flowbite": "^4.0.2",
    "flowbite-svelte": "^1.33.1",
    "flowbite-svelte-icons": "^3.1.0",
    "gas-client": "^1.2.1",
    "gas-types-detailed": "^1.1.3",
    "husky": "^9.1.7",
    "knip": "^6.33.0",
    "rolldown": "1.2.1",
    "storybook": "^10.5.10",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plugin-static-copy": "^4.1.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melledijkstra/gas-fire.git"
  },
  "keywords": [
    "google-apps-script",
    "typescript",
    "financial",
    "automation",
    "script",
    "sheet",
    "google"
  ],
  "bugs": {
    "url": "https://github.com/melledijkstra/gas-fire/issues"
  }
}
