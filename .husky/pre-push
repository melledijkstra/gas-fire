#!/bin/bash
# .git/hooks/pre-push
#
# a git pre-push hook to verify that the package.json version has been updated
# when pushing to remote.

# exit immediately if a command exits with a non-zero status.
set -o errexit
# treat unset variables as an error.
set -o nounset

# path to package.json relative to repository root.
PACKAGE_JSON_FILE="package.json"
# base branch to compare against.
BASE_BRANCH="origin/main"

# helper function to extract the version string from package.json at a specific git ref.
get_version_from_ref() {
    local ref=$1
    local file_path=$2
    git show "${ref}:${file_path}" 2>/dev/null | \
        grep '"version":' | \
        sed -E 's/.*"version": *"([^"]+)".*/\1/' || true
}

check_version_bump() {
    echo "--- [Git Hook] Running pre-push version check ---"
    echo "Comparing against base branch: '$BASE_BRANCH'"

    local null_sha="0000000000000000000000000000000000000000"
    local base_branch_name="${BASE_BRANCH#origin/}"

    # pre-push hook receives refs to be pushed on stdin:
    # <local ref> <local sha> <remote ref> <remote sha>
    while read -r local_ref local_sha remote_ref remote_sha
    do
        # skip if branch is being deleted.
        if [ "$local_sha" = "$null_sha" ] || [ "$local_ref" = "(delete)" ]; then
            echo "Branch ($remote_ref) is being deleted, skipping version check."
            continue
        fi

        # only check local branches (skip tags or other ref types).
        case "$local_ref" in
            refs/heads/*) ;;
            *)
                echo "Push does not involve a branch ($local_ref), skipping version check."
                continue
                ;;
        esac

        local branch_name="${local_ref#refs/heads/}"
        local remote_branch_name="${remote_ref#refs/heads/}"

        # confirmation prompt when pushing directly to base branch (e.g. main).
        if [ "$branch_name" = "$base_branch_name" ] || [ "$remote_branch_name" = "$base_branch_name" ]; then
            if (exec 3</dev/tty) 2>/dev/null; then
                printf "⚠️  You are pushing directly to '%s'. Are you sure you want to continue? [y/N] " "$base_branch_name" >&2
                read -r confirm < /dev/tty
                case "$confirm" in
                    [yY]|[yY][eE][sS])
                        echo "Pushing directly to base branch ('$base_branch_name'). Proceeding without version check."
                        continue
                        ;;
                    *)
                        echo "Push to '$base_branch_name' aborted by user." >&2
                        exit 1
                        ;;
                esac
            else
                echo "Pushing to base branch ('$base_branch_name') in non-interactive environment, skipping version check."
                continue
            fi
        fi

        # skip if branch is already up-to-date with remote.
        if [ "$local_sha" = "$remote_sha" ]; then
            echo "Branch '$branch_name' is up to date, skipping version check."
            continue
        fi

        if [ "$remote_sha" = "$null_sha" ]; then
            echo "Checking new branch '$branch_name' (comparing against '$BASE_BRANCH')..."
        else
            echo "Checking branch '$branch_name' for commits in range $remote_sha..$local_sha"
        fi

        # fetch latest changes for base branch to ensure accurate comparison.
        echo "Fetching latest changes for '$BASE_BRANCH'..."
        git fetch origin "$base_branch_name" >/dev/null 2>&1 || true

        # get version from commit being pushed and from base branch.
        local_version=$(get_version_from_ref "$local_sha" "$PACKAGE_JSON_FILE")
        main_version=$(get_version_from_ref "$BASE_BRANCH" "$PACKAGE_JSON_FILE")
        if [ -z "$main_version" ]; then
            main_version=$(get_version_from_ref "$base_branch_name" "$PACKAGE_JSON_FILE")
        fi

        echo "Version in '$branch_name' is: '$local_version'"
        echo "Version in '$BASE_BRANCH' is: '$main_version'"

        # if version cannot be determined, warn and skip.
        if [ -z "$local_version" ] || [ -z "$main_version" ]; then
            echo "Warning: Could not determine version from one of the branches. Skipping check."
            continue
        fi

        # enforce version bump for all non-base branches.
        if [ "$local_version" = "$main_version" ]; then
            echo "============================================================" >&2
            echo "!! PUSH REJECTED !!" >&2
            echo "The version in '$PACKAGE_JSON_FILE' ('$local_version') has not been updated" >&2
            echo "relative to the base branch '$BASE_BRANCH' ('$main_version')." >&2
            echo "Please increment the version before pushing." >&2
            echo "============================================================" >&2

            # helpful reminder if user bumped package.json in working tree without committing.
            if ! git diff --quiet -- "$PACKAGE_JSON_FILE" 2>/dev/null || ! git diff --cached --quiet -- "$PACKAGE_JSON_FILE" 2>/dev/null; then
                working_version=$(grep '"version":' "$PACKAGE_JSON_FILE" 2>/dev/null | sed -E 's/.*"version": *"([^"]+)".*/\1/' || true)
                if [ -n "$working_version" ] && [ "$working_version" != "$local_version" ]; then
                    echo "" >&2
                    echo "💡 Notice: '$PACKAGE_JSON_FILE' has uncommitted changes (version '$working_version')." >&2
                    echo "   Commit your version bump before pushing!" >&2
                    echo "" >&2
                fi
            fi

            exit 1
        else
            echo "Version has been updated from '$main_version' to '$local_version'. Great!"
        fi
    done

    echo "--- [Git Hook] All checks passed. Proceeding with push. ---"
}

check_version_bump
exit 0
